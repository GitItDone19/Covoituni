<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="gui.Users.ResetPasswordController">
    <VBox spacing="20" alignment="CENTER" prefWidth="400" prefHeight="300">

        <!-- Title -->
        <Text text="Reset Your Password" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- New Password Input -->
        <Label text="New Password:" />
        <PasswordField fx:id="tfNewPassword" promptText="Enter new password" />

        <!-- Confirm Password Input -->
        <Label text="Confirm Password:" />
        <PasswordField fx:id="tfConfirmPassword" promptText="Re-enter new password" />

        <!-- Buttons -->
        <HBox spacing="10">
            <Button text="Reset Password" onAction="#handleReset" />

        </HBox>
    </VBox>
</AnchorPane>
