<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.Circle?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="gui.Users.DashboardUserController">
    
    <AnchorPane stylesheets="@../styles/global.css"
                style="-fx-background-color: #82f6c9;">
                
        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" 
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            
            <!-- Left Sidebar - Enhanced design -->
            <VBox styleClass="sidebar" prefWidth="320.0" spacing="20.0" minWidth="320.0" 
                  style="-fx-background-color: linear-gradient(to bottom, #1a2e40, #24364c); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 0);">
                <padding>
                    <Insets top="30.0" right="20.0" bottom="30.0" left="20.0"/>
                </padding>
                
                <!-- Logo and Title - Enhanced -->
                <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 0 0 10 0;">
                    <StackPane>
                        <Circle radius="25" style="-fx-fill: #24f0a0;"/>
                        <ImageView fitHeight="40.0" fitWidth="40.0">
                            <Image url="@../images/logo.png"/>
                        </ImageView>
                    </StackPane>
                    <VBox>
                        <Label text="Covoituni" styleClass="logo-title" style="-fx-text-fill: #24f0a0; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                        <Label text="Voyagez ensemble" styleClass="logo-subtitle" style="-fx-text-fill: #82f6c9; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
                
                <Separator styleClass="sidebar-separator" style="-fx-background-color: transparent; -fx-border-color: #3a4a5c; -fx-opacity: 0.6;"/>
                
                <!-- Navigation Categories -->
                <Label text="MENU PRINCIPAL" styleClass="nav-section-label" style="-fx-text-fill: #82f6c9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 0 5 10;"/>
                
                <!-- Wrap the navigation links in a ScrollPane with enhanced styling -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" 
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                    <content>
                        <VBox spacing="5" fillWidth="true" style="-fx-background-color: transparent;">
                            <!-- Non-role specific buttons with icons -->
                            <Button text=" 👤 Voir Profile" onAction="#handleViewProfile" 
                                    styleClass="sidebar-button" maxWidth="Infinity" 
                                    style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            <Button text=" 📝 Faire une réclamation" onAction="#handleAddReclamation"
                                    styleClass="sidebar-button" maxWidth="Infinity" 
                                    style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            <Button fx:id="btnGoogleTranslator"
                                    text="🌍 Google Translator"
                                    onAction="#handleOpenGoogleTranslator"
                                    styleClass="sidebar-button" maxWidth="Infinity" 
                                    style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            
                            <Separator style="-fx-background-color: transparent; -fx-border-color: #3a4a5c; -fx-opacity: 0.3; -fx-padding: 5 0;"/>
                            <Label text="ÉVÉNEMENTS ET ANNONCES" styleClass="nav-section-label" style="-fx-text-fill: #82f6c9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 0 5 10;"/>

                            <!-- Passenger & Driver shared buttons -->
                            <Button fx:id="btnListeEvenements" text=" 🎭 Liste des Événements" onAction="#handleListeEvenements"
                                    styleClass="sidebar-button" maxWidth="Infinity" 
                                    style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            <Button fx:id="btnListeAnnoncesEvent" text=" 📢 Annonces d'Événements" onAction="#handleListeEvenements"
                                    styleClass="sidebar-button" maxWidth="Infinity" 
                                    style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            <Button fx:id="btnListeAnnonces" text=" 📋 Liste des Annonces" onAction="#handleListeAnnonces"
                                    styleClass="sidebar-button" maxWidth="Infinity" 
                                    style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            
                            <!-- Passenger-only section - Only visible for passengers -->
                            <VBox fx:id="passengerSection" spacing="5" fillWidth="true" style="-fx-background-color: transparent;">
                                <Separator style="-fx-background-color: transparent; -fx-border-color: #3a4a5c; -fx-opacity: 0.3; -fx-padding: 5 0;"/>
                                <Label text="PASSAGER" styleClass="nav-section-label" style="-fx-text-fill: #82f6c9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 0 5 10;"/>
                                
                                <Button fx:id="btnReservationsPassager" text=" 🎫 Mes Réservations" onAction="#handleReservationsPassager"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnHistorique" text=" 📜 Historique" onAction="#handleHistorique"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnAjouterAvis" text=" ⭐ Ajouter Avis" onAction="#handleAjouterAvis"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            </VBox>
                            
                            <!-- Driver-only section - Only visible for drivers -->
                            <VBox fx:id="driverSection" spacing="5" fillWidth="true" style="-fx-background-color: transparent;">
                                <Separator style="-fx-background-color: transparent; -fx-border-color: #3a4a5c; -fx-opacity: 0.3; -fx-padding: 5 0;"/>
                                <Label text="CONDUCTEUR" styleClass="nav-section-label" style="-fx-text-fill: #82f6c9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 0 5 10;"/>
                                
                                <Button fx:id="btnReservationsChauffeur" text=" 🔄 Gérer Réservations" onAction="#handleReservationsChauffeur"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnAjoutAnnonce" text=" ➕ Ajouter Annonce" onAction="#handleAjoutAnnonce"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnAjoutTrajet" text=" 🚗 Ajouter Trajet" onAction="#handleAjoutTrajet"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnAjoutEvent" text=" 🎉 Ajouter Événement" onAction="#handleAjoutEvent"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnListeTrajet" text=" 📋 Liste des Trajets" onAction="#handleListeTrajet"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnModifierTrajet" text=" ✏️ Modifier Trajet" onAction="#handleModifierTrajet"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnModifierAnnonce" text=" ✏️ Modifier Annonce" onAction="#handleModifierAnnonce"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnModifierEvent" text=" ✏️ Modifier Événement" onAction="#handleModifierEvent"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                
                                <Separator style="-fx-background-color: transparent; -fx-border-color: #3a4a5c; -fx-opacity: 0.3; -fx-padding: 5 0;"/>
                                <Label text="VÉHICULES" styleClass="nav-section-label" style="-fx-text-fill: #82f6c9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 0 5 10;"/>
                                
                                <Button fx:id="btnAfficherVoitures" text=" 🚙 Mes Voitures" onAction="#handleAfficherVoitures"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnAjouterVoiture" text=" ➕ Ajouter Voiture" onAction="#handleAjouterVoiture"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnModifierVoiture" text=" ✏️ Modifier Voiture" onAction="#handleModifierVoiture"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                
                                <Separator style="-fx-background-color: transparent; -fx-border-color: #3a4a5c; -fx-opacity: 0.3; -fx-padding: 5 0;"/>
                                <Label text="CATÉGORIES" styleClass="nav-section-label" style="-fx-text-fill: #82f6c9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 0 5 10;"/>
                                
                                <Button fx:id="btnAfficherCategories" text=" 📂 Catégories" onAction="#handleAfficherCategories"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnAjouterCategorie" text=" ➕ Ajouter Catégorie" onAction="#handleAjouterCategorie"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                                <Button fx:id="btnModifierCategorie" text=" ✏️ Modifier Catégorie" onAction="#handleModifierCategorie"
                                        styleClass="sidebar-button" maxWidth="Infinity" 
                                        style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            </VBox>
                            
                            <Separator style="-fx-background-color: transparent; -fx-border-color: #3a4a5c; -fx-opacity: 0.3; -fx-padding: 5 0;"/>
                            <Label text="OUTILS" styleClass="nav-section-label" style="-fx-text-fill: #82f6c9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 0 5 10;"/>
                            
                            <Button fx:id="mapButton" 
                                    text="📍 Cartographie" 
                                    onAction="#handleOpenMap"
                                    styleClass="sidebar-button" maxWidth="Infinity" 
                                    style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                            <Button fx:id="chatbotButton" 
                                    text="💬 Assistant" 
                                    onAction="#handleOpenChatbot"
                                    styleClass="sidebar-button" maxWidth="Infinity" 
                                    style="-fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"/>
                        </VBox>
                    </content>
                </ScrollPane>
                
                <!-- User Info Section - Enhanced -->
                <VBox styleClass="user-info" spacing="15.0" 
                      style="-fx-background-color: linear-gradient(to right, #25765d, #1d5e4a); -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 1);">
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <StackPane>
                            <Circle fx:id="userAvatar" radius="25" 
                                    style="-fx-fill: #24f0a0;"/>
                            <Label text="👤" style="-fx-font-size: 20px;"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label fx:id="lblUserName" styleClass="user-name" 
                                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <Label fx:id="lblUserEmail" styleClass="user-email" 
                                   style="-fx-text-fill: #a9e4d2; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>
                    <Button text="🚪 Déconnexion" onAction="#handleLogout" 
                            styleClass="logout-button" 
                            style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                </VBox>
            </VBox>
            
            <!-- Main Content Area -->
            <VBox HBox.hgrow="ALWAYS" spacing="25.0" style="-fx-background-color: #82f6c9;">
                <padding>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                </padding>
                
                <!-- Statistics Cards -->
                <HBox spacing="20.0">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" 
                          style="-fx-background-color: #0985fa; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Réservations Actives" styleClass="stat-label" 
                               style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        <Label fx:id="lblActiveReservations" text="5" styleClass="stat-value" 
                               style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" 
                          style="-fx-background-color: #0985fa; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="CO₂ Économisé" styleClass="stat-label" 
                               style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        <Label fx:id="lblCO2Economy" text="156 kg" styleClass="stat-value" 
                               style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" 
                          style="-fx-background-color: #0985fa; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Note Moyenne" styleClass="stat-label" 
                               style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        <Label fx:id="lblRating" text="4.8" styleClass="stat-value" 
                               style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
                
                <!-- Reservations List -->
                <VBox VBox.vgrow="ALWAYS" styleClass="card" 
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label text="Vos Réservations" styleClass="section-title" 
                               style="-fx-text-fill: #28444c; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField promptText="Rechercher..." styleClass="search-field" 
                                  style="-fx-background-radius: 20; -fx-padding: 8 15;"/>
                    </HBox>
                    
                    <ListView fx:id="listViewReservations" VBox.vgrow="ALWAYS" 
                             styleClass="reservations-list" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10; -fx-background-color: transparent;"/>
                </VBox>
            </VBox>
        </HBox>
    </AnchorPane>
</StackPane> 