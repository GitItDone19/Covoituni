<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane stylesheets="@../styles/global.css"
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.Users.Auth0LoginController">
            
    <center>
        <VBox alignment="CENTER" spacing="20" maxWidth="400">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            
            <!-- Header -->
            <Text text="Connexion à Covoituni" styleClass="title-text"/>
            <Text text="Choisissez votre méthode de connexion" styleClass="subtitle-text"/>
            
            <Separator/>
            
            <!-- Auth0 Login Button -->
            <Button fx:id="btnAuth0Login" 
                    text="Se connecter avec Auth0" 
                    onAction="#handleAuth0Login"
                    styleClass="auth0-button"
                    maxWidth="Infinity">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Text text="🔒" style="-fx-font-size: 18px;"/>
                    </HBox>
                </graphic>
            </Button>
            
            <!-- Status -->
            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="lblStatus" styleClass="status-label"/>
                <ProgressIndicator fx:id="progressIndicator" prefHeight="20" prefWidth="20"/>
            </HBox>
            
            <Text text="OU" styleClass="or-text"/>
            
            <!-- Traditional Login Button -->
            <Button fx:id="btnTraditionalLogin" 
                    text="Connexion traditionnelle" 
                    onAction="#handleTraditionalLogin"
                    styleClass="traditional-button"
                    maxWidth="Infinity"/>
            
            <!-- Footer -->
            <Text text="En vous connectant, vous acceptez nos conditions d'utilisation et notre politique de confidentialité." 
                  styleClass="footer-text" 
                  textAlignment="CENTER" 
                  wrappingWidth="300"/>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="5" styleClass="footer">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Text text="© 2023 Covoituni. Tous droits réservés." styleClass="copyright-text"/>
        </HBox>
    </bottom>
</BorderPane> 