<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../styles/global.css"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.Users.ForgotPasswordController">

    <HBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <!-- Left Side - Image -->
        <VBox style="-fx-background-color: -fx-secondary;" HBox.hgrow="ALWAYS" alignment="CENTER">
            <ImageView fitWidth="300" preserveRatio="true">
                <Image url="@images/logo.png"/>
            </ImageView>
            <Label text="Mot de passe oublié ?" styleClass="title-label" style="-fx-text-fill: white;"/>
            <Label text="Nous vous enverrons un nouveau mot de passe" style="-fx-text-fill: -fx-light-gray;"/>
        </VBox>

        <!-- Right Side - Reset Password Form -->
        <VBox alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS" style="-fx-background-color: white;">
            <padding>
                <Insets top="50" right="50" bottom="50" left="50"/>
            </padding>

            <Label text="Réinitialisation du mot de passe" styleClass="title-label"/>
            
            <Text text="Entrez votre adresse e-mail et nous vous enverrons un nouveau mot de passe temporaire. Vous pourrez le changer après votre connexion." 
                  wrappingWidth="300" textAlignment="CENTER" style="-fx-fill: -fx-dark-gray;"/>

            <VBox spacing="10">
                <Label text="Email"/>
                <TextField fx:id="tfEmail" promptText="Entrez votre email"/>
            </VBox>

            <Button text="ENVOYER UN NOUVEAU MOT DE PASSE" onAction="#handleResetPassword"
                    maxWidth="Infinity" defaultButton="true" styleClass="button-primary"/>

            <Separator style="-fx-opacity: 0.2;"/>

            <HBox alignment="CENTER" spacing="10">
                <Label text="Vous vous souvenez de votre mot de passe ?" style="-fx-text-fill: -fx-dark-gray;"/>
                <Button text="Se connecter" onAction="#handleBackToLogin"
                        styleClass="button-outline"/>
            </HBox>
        </VBox>
    </HBox>
</AnchorPane>
