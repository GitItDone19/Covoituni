<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="gui.Users.ForgotPasswordController">
    <VBox spacing="20" alignment="CENTER" prefWidth="400" prefHeight="300">

        <!-- Title -->
        <Text text="Forgot Password" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- Email Input -->
        <Label text="Enter your email:" />
        <TextField fx:id="tfEmail" promptText="example@example.com" />

        <!-- Buttons -->
        <HBox spacing="10">
            <Button text="Send Reset Link" onAction="#handleResetPassword" />
            <Button text="Back to Login" onAction="#handleBackToLogin" />
        </HBox>
    </VBox>
</AnchorPane>
