<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.Users.GestionPassagerController"
      spacing="20"
      style="-fx-background-color: white; -fx-padding: 20;">

    <Label text="Gestion des Passagers" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

    <TableView fx:id="passagerTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 8; -fx-padding: 10;">
        <!-- Define columns here -->
    </TableView>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Ajouter" onAction="#handleAjouter" style="-fx-background-color: #34D186; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;"/>
        <Button text="Modifier" onAction="#handleModifier" style="-fx-background-color: #EEEEEE; -fx-text-fill: #333333; -fx-background-radius: 8; -fx-padding: 10 20;"/>
        <Button text="Supprimer" onAction="#handleSupprimer" style="-fx-background-color: #EEEEEE; -fx-text-fill: #333333; -fx-background-radius: 8; -fx-padding: 10 20;"/>
    </HBox>
</VBox> 